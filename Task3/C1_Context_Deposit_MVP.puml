@startuml C1_Context_Deposit_MVP
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Диаграмма контекста (C1) для открытия депозитов онлайн (MVP)

' --- АКТОРЫ ---
Person(client, "Клиент", "Физическое лицо, желающее открыть депозит")
Person(new_client, "Новый клиент", "Физическое лицо без счета в банке")
Person(back_office, "Сотрудник бэк-офиса", "Обрабатывает заявки на депозиты")
Person(call_center, "Оператор кол-центра", "Консультирует клиентов по депозитам")

' --- СИСТЕМЫ БАНКА ---
System(deposit_system, "Система депозитов", "Новая система для приема и обработки заявок на депозиты онлайн")
System(abs, "АБС", "Автоматизированная Банковская Система - ядро банка")
System(ib, "Интернет-банк", "Онлайн-канал для существующих клиентов")
System(site, "Сайт банка", "Маркетинговая информация и прием заявок")

' --- ВНЕШНИЕ СИСТЕМЫ ---
System_Ext(telecom_operator, "Телеком-оператор", "Отправка SMS-уведомлений")
System_Ext(cc_system, "Система кол-центра", "CRM для обработки обращений")

' --- ВЗАИМОДЕЙСТВИЯ КЛИЕНТОВ ---
Rel(client, ib, "Подает заявку на депозит, видит персонализированные ставки", "HTTPS")
Rel(new_client, site, "Подает заявку на депозит, оставляет контакты", "HTTPS")
Rel(new_client, call_center, "Получает звонок с предложением", "Телефон")

' --- ВЗАИМОДЕЙСТВИЯ СИСТЕМЫ ДЕПОЗИТОВ ---
Rel(ib, deposit_system, "Отправляет заявку", "REST API")
Rel(site, deposit_system, "Отправляет заявку", "REST API")
Rel(deposit_system, telecom_operator, "Отправляет SMS-уведомления клиенту", "REST API")

' --- ВЗАИМОДЕЙСТВИЯ БЭК-ОФИСА ---
Rel(back_office, deposit_system, "Просматривает и обрабатывает заявки", "Web UI")
Rel(back_office, abs, "Открывает депозит вручную", "Desktop UI")

' --- ВЗАИМОДЕЙСТВИЯ КОЛ-ЦЕНТРА ---
Rel(call_center, cc_system, "Работает с обращениями клиентов")
Rel(cc_system, deposit_system, "Получает информацию о заявках", "REST API")

' --- СПРАВОЧНЫЕ ДАННЫЕ ---
Rel(deposit_system, abs, "Получает данные клиента, проверяет счета", "REST API")

@enduml
