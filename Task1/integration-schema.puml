@startuml C1_Context_AsIs
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Диаграмма контекста (C1) для Банка "Стандарт" (As-Is)

' --- АКТОРЫ (ЛЮДИ) ---
Person(client, "Клиент", "Физическое лицо, пользующееся услугами банка")
Person(branch_employee, "Сотрудник отделения", "Фронт-офис, работает с клиентами в отделении")
Person(back_office_employee, "Сотрудник бэк-офиса", "Обрабатывает заявки на депозиты и кредиты")
Person(call_center_agent, "Оператор колл-центра", "Принимает звонки от клиентов")

' --- ВНЕШНИЕ СИСТЕМЫ ---
System_Ext(credit_bureau, "Бюро кредитных историй", "Внешний поставщик данных о кредитной истории")
System_Ext(telecom_operator, "Телеком-оператор", "Внешний провайдер для отправки СМС")
System_Ext(partner_cc, "Система партнёрского КЦ", "Внешняя система, используется для аутсорс-поддержки")

' --- КЛЮЧЕВЫЕ IT-СИСТЕМЫ ---
System(abs, "АБС (Автоматизированная Банковская Система)", "Ядро банка. Delphi + Oracle PL/SQL. Хранит все данные.")
System(ib, "Интернет-банк", ".NET монолит. Основной онлайн-канал для клиентов.")
System(credit_conveyor, "Кредитный конвейер", "BPMS на Camunda. Обрабатывает кредитные заявки.")
System(scoring_system, "Система скоринга", "Python ML сервис. Оценивает кредитные риски.")
System(cc_system, "Система кол-центра", "CRM-платформа подрядчика. Используется для обработки звонков.")
System(site, "Сайт", "PHP/React.js. Маркетинговая информация.")

' --- ВЗАИМОДЕЙСТВИЯ (Rel) ---
'
' Клиент
Rel(client, site, "Просматривает маркетинговую информацию о продуктах", "HTTPS")
Rel(client, ib, "Управляет счетами, проводит платежи, открывает текущие счета", "HTTPS")
Rel(client, branch_employee, "Обращается в отделение для открытия депозитов и кредитов")
Rel(client, call_center_agent, "Звонит для консультации по депозитам и кредитам")

' Сотрудник отделения (фронт-офис)
Rel(branch_employee, abs, "Заводит заявки на депозиты и кредиты, проводит операции", "Delphi клиент")
Rel(branch_employee, back_office_employee, "Запрашивает согласование ставок по депозитам", "Email")

' Сотрудник бэк-офиса
Rel(back_office_employee, abs, "Обрабатывает заявки на депозиты, определяет и согласовывает ставки", "Delphi клиент")
Rel(back_office_employee, credit_conveyor, "Обрабатывает кредитные заявки, принимает решения", "Web UI")
Rel(back_office_employee, branch_employee, "Отправляет согласованные ставки", "Email")

' Оператор кол-центра
Rel(call_center_agent, cc_system, "Принимает звонки, заводит обращения клиентов", "Web UI")
Rel(call_center_agent, client, "Консультирует по депозитам и кредитам")

' Интернет-банк
Rel(ib, abs, "Читает/пишет данные о счетах и платежах", "ПРЯМОЙ ДОСТУП К БД")

' АБС (ядро банка)
Rel(abs, telecom_operator, "Отправляет СМС-уведомления клиентам", "API")
Rel(abs, credit_conveyor, "Передает заявки на кредиты", "БД интеграция, раз в день")
Rel(credit_conveyor, abs, "Возвращает решения по кредитам и обновления статусов", "БД интеграция, раз в день")

' Система кол-центра
Rel(cc_system, abs, "Передает обращения клиентов на обработку", "Интеграция")

' Кредитный конвейер
Rel(credit_conveyor, scoring_system, "Запрашивает скоринговый балл клиента", "REST API")

' Система скоринга
Rel(scoring_system, credit_bureau, "Запрашивает кредитную историю клиента", "REST API онлайн")
Rel(scoring_system, abs, "Получает данные о клиентах и истории платежей", "БД интеграция, раз в сутки")
Rel(scoring_system, credit_conveyor, "Получает информацию о номерах платежей по договорам", "БД интеграция")

' Партнерский кол-центр
Rel(partner_cc, back_office_employee, "Получает скрипты звонков для обработки клиентов")
Rel(partner_cc, client, "Обрабатывает звонки клиентов по готовым скриптам")

@enduml